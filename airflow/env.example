# Copier en .env (non versionné) : cp env.example .env

# Lakehouse : S3 en prod...
LAKE_ROOT=s3://velib-pipeline-fz-prod-data/lake
AWS_REGION=eu-north-1
# Utilisateur IAM velib-airflow-local (droits limités à lake/*)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DBT_TARGET=prod

# Qdrant : réindexé chaque jour par le job d'embeddings (optionnel)
QDRANT_URL=
QDRANT_API_KEY=

# ...ou un lakehouse local pour tester sans AWS (dossier ../lake monté dans le conteneur) :
# LAKE_ROOT=/opt/project/lake
# DBT_TARGET=local

# Secret partagé par les composants Airflow 3 (tokens de l'API d'exécution).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__API_AUTH__JWT_SECRET=change-me

AIRFLOW_UID=50000

# Port de l'interface web (changer si 8080 est déjà pris sur le PC)
AIRFLOW_PORT=8080
